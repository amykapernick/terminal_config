# This repo lives directly in ~, so it ignores EVERYTHING by default and
# only tracks what's explicitly allowed below. This keeps app data, caches
# and secrets (.env, ~/.ssh, ~/.config/*) from ever being committed by a
# stray `git add -A`. To track something new, add a `!/path` line.
/*

# Repo files
!/.gitignore
!/.gitmodules
!/README.md
!/CLAUDE.md
!/setup_terminal.sh
!/bulk_issues.md

# Shell (zsh is the main shell; bash files are just a fallback)
!/.zshrc
!/.zshenv
!/.zsh/
# private SSH helpers; shareable ones go in hosts.zsh
/.zsh/conf/ssh.zsh
!/.profile
!/.bashrc
!/.bash_logout
!/.hushlogin

# Git
!/.gitconfig
!/.gitignore_global

# App config (only specific files inside ~/.config)
!/.config/
/.config/*
!/.config/starship.toml
!/.config/ghostty/
!/.config/vicinae/
# work modes (this machine only for now)
!/.config/modes/

# Scripts and submodules
# own executables, on PATH (see README > Adding scripts)
!/bin/
# scripts called by zsh functions, not run directly
!/functions/
!/git-summary

# Empty project folders (keep the folder, ignore the contents).
# ~/makerx is deliberately not here: it only exists on one machine.
!/dev/
/dev/*
!/dev/.gitkeep
!/web/
/web/*
!/web/.gitkeep
!/training/
/training/*
!/training/.gitkeep

# Never commit, even inside allowed folders
__pycache__/
*.pyc
.env
.env.*
!.env.example
