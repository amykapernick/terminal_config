# Reload ~/.zshrc to pick up function/alias changes
refresh () {
        source ~/.zshrc
}

# Check git repos under ~ for uncommitted work and global npm packages for updates
check () {
	cd ~
	git-check -d
	npm-check -g
}

# Delete Windows Zone.Identifier files under the current folder
del_zone () {
	 find . -regex ".*Zone.Identifier$" -delete
}

# Expose a local port publicly with tunnelto
# usage: tunnel [subdomain=amy] [port=8000]
tunnel () {
	local port="${2:-8000}" subdomain="${1:-amy}"
	tunnelto --subdomain $subdomain --port $port --dashboard-port 60000
}

# Generate an ed25519 SSH key in ~/.ssh and add it to the agent
# usage: new_ssh <key-name> [email=amy@kapers.dev]
new_ssh () {
	ssh-keygen -t ed25519 -C "${2:-amy@kapers.dev}" -f ~/.ssh/$1
	eval "$(ssh-agent -s)"
	ssh-add ~/.ssh/$1
}

# Start the ssh-agent in this shell
ssh_start () {
	eval "$(ssh-agent -s)"
}

# aliases
source ~/.bash_alias

# environment variables
source ~/.env

# Functions
source ~/bash_func/.init
source ~/bash_func/.git_func
source ~/bash_func/.packages
source ~/bash_func/.nav
source ~/bash_func/.utils
source ~/bash_func/.vscode
[ -f ~/bash_func/.ssh_func ] && source ~/bash_func/.ssh_func
source ~/bash_func/.help
# source ~/bash_func/.zoxide