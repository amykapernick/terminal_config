# Stage everything, commit with a message and push
# usage: pushit "<message>"
pushit () {
        git add -A
        git commit -m "$1"
        git push
}

# Stage everything and commit with a message (no push)
# usage: commit "<message>"
commit () {
        git add -A
        git commit -m "$1"
}

# Create and switch to a new branch
# usage: branch <name>
branch () {
	git checkout -b $1
}

# Rename master to prod and push it as the upstream
main_branch () {
	git branch -m master prod
	git push origin HEAD
	git push --set-upstream origin prod
}

# Set a local branch to track origin/<branch>
# usage: upstream <branch>
upstream () {
	git branch --set-upstream-to=origin/$1 $1
}

# Upload ~/.ssh/<key>.pub to GitHub and list your keys
# usage: gh_ssh <key-name> <title>
gh_ssh () {
	name=$1
	terminal=$2

	gh ssh-key add ~/.ssh/$name.pub -t $terminal
	gh ssh-key list
}

# Clone a repo with a specific SSH key and keep using that key for the repo
# usage: ssh_clone <git-ssh-url> <key-file>
ssh_clone () {
	url=$1
	ssh_key=$2

	if [ -z "$url" ] || [ -z "$ssh_key" ]; then
		echo "Usage: ssh_clone <git ssh url> <ssh key file>"
		return 1
	fi

	ssh_cmd="ssh -i $ssh_key -o IdentitiesOnly=yes"

	GIT_SSH_COMMAND="$ssh_cmd" git clone "$url" && git -C "$(basename "$url" .git)" config core.sshCommand "$ssh_cmd"
}
