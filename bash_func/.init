# New Node project: folder, git, licence, .gitignore, CoC, GitHub remote, initial commit
# usage: i_node <project-name>
i_node () {
	mkdir $1
	cd $1
	git init
	npx license --projectName $1
  	npx gitignore node
  	npx covgen "$(npm get init-author-email)"
  	git remote add origin git@github.com:amykapernick/$1.git
	npm init -y
  	git add -A
  	git commit -m "Initial commit"

	
	# license="`cat ~/license`"
	# # echo "${$license/}"
	# year=2023
	# year_term=insert_year

	# # sed "s/{year}/$year/g" <<<"$license"

	# # echo ${license/{year}/"2023"}

	# echo "${license/year_term/year}"

	# # $license=$(echo "`cat ~/license`" | sed "s/{year}/2020/")
}

# Write doppler.yaml (dev config) for a project and run doppler setup
# usage: i_doppler <doppler-project>
i_doppler () {
	echo "setup:" >> doppler.yaml
	echo "        project: $1" >> doppler.yaml
	echo "        config: dev" >> doppler.yaml
	doppler setup
}

# Start ssh-agent and add ~/.ssh/id_default
fix_ssh () {
	eval "$(ssh-agent -s)"
	ssh-add ~/.ssh/id_default
}

# Clone a repo, cd in, npm install and copy .env.example to .env
# usage: clone <git-url>
clone () {
	git clone $1
	repo=`expr "$1" :  '.*\(\/[a-z]*\.git\)'`
	repo=${repo#/}
	repo=${repo%.git}
	echo $repo
	cd $repo
	npm install
	cp .env.example .env
}