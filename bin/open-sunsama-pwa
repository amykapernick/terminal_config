#!/bin/sh
# Waits for the Open Sunsama web app (up to 3 min), then opens the Edge PWA.
for _ in $(seq 90); do
  /usr/bin/curl -fs -o /dev/null http://localhost:3002/ && break
  sleep 2
done
exec /opt/microsoft/msedge/microsoft-edge --profile-directory=Default --app-id=pdappogamddnobojoejcaibooiabaenm --app-url=http://localhost:3002/app
