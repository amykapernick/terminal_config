# Font (check the exact name with: ghostty +list-fonts | grep -i krypton)
font-family = "Monaspace Krypton"
font-size = 13

# Monaspace features: calt is texture healing + ligatures, ssXX are stylistic sets.
# Remove any you don't like.
font-feature = calt
font-feature = liga
font-feature = ss01
font-feature = ss02
font-feature = ss03
font-feature = ss07
font-feature = ss08

# Theme that follows the system light/dark setting (browse with: ghostty +list-themes)
theme = light:Catppuccin Latte,dark:Catppuccin Mocha

# Look and feel
window-padding-x = 10
window-padding-y = 8
cursor-style = bar
background-opacity = 0.95
copy-on-select = false
keybind = ctrl+shift+c=copy_to_clipboard:plain
keybind = ctrl+v=paste_from_clipboard
working-directory = home
window-inherit-working-directory = false
