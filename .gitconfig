[user]
	name = Amy Kapernick
	username = amykapernick
# Private settings (email addresses): ~/.gitconfig.local, not in git.
# Kept above the includeIf blocks so the work configs can override user.email.
[include]
	path = ~/.gitconfig.local
[init]
	defaultBranch = prod
[push]
	default = current
	autoSetupRemote = true
[core]
	excludesfile = /home/amy/.gitignore_global

[includeIf "gitdir:~/web/"]
	path=~/web/.gitconfig_include
[includeIf "gitdir:~/makerx/"]
	path=~/makerx/.gitconfig
[pull]
	rebase = false
[pager]
	branch = false
